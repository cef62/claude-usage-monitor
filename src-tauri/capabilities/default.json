{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Popover window: core events plus opening claude.ai and repository links in the browser",
  "windows": ["popover"],
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://claude.ai/*" }, { "url": "https://github.com/cef62/claude-usage-monitor*" }]
    }
  ]
}
